# Ibha KSP — Backend Environment Variables
# ==========================================
# Copy this file to .env.backend and fill in the real values.
# .env.backend is listed in .gitignore and must NEVER be committed.
#
# Usage:
#   cp .env.backend.example .env.backend
#   # edit .env.backend with your values
#   python local_server.py

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local development: use localhost defaults below.
# Cloud/Catalyst deployment: replace with your cloud PostgreSQL host.
#   Examples: ElephantSQL, Supabase, Render, Aiven, Railway, etc.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibha
DB_USER=postgres

# REQUIRED — set to your actual password before running the server.
# For cloud PostgreSQL this is the password from the provider dashboard.
DB_PASSWORD=change_me

# SSL mode for PostgreSQL connections.
# Local development:   prefer   (SSL if available, plain otherwise)
# Cloud / production:  require  (always require SSL — strongly recommended)
DB_SSLMODE=prefer

# ── Database mode ─────────────────────────────────────────────────────────
# false = use PostgreSQL (default, recommended)
# true  = route through Catalyst Data Store ZCQL (optional, not primary)
USE_CATALYST_DS=false

# ── Authentication ────────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# This value must be identical in local_server.py and the Catalyst Function env.
IBHA_JWT_SECRET=change_me

# ══════════════════════════════════════════════════════════════════════════
# Notes
# ══════════════════════════════════════════════════════════════════════════
#
# Local development:
#   - DB_HOST=localhost is correct for a locally running PostgreSQL instance.
#   - DB_SSLMODE=prefer works with all local setups.
#   - DB_PASSWORD must match your local PostgreSQL user password.
#
# Catalyst cloud deployment:
#   - Set DB_HOST to the hostname of your cloud PostgreSQL provider.
#   - Set DB_SSLMODE=require (cloud PostgreSQL requires SSL).
#   - Set DB_PASSWORD to the password from your cloud database dashboard.
#   - Set IBHA_JWT_SECRET to a strong random value in Catalyst Console →
#     Functions → Environment Variables.
#   - DO NOT store production secrets in any .env file in the repository.
#
# Security:
#   - Never commit .env.backend or any file containing real passwords.
#   - .gitignore already excludes .env, .env.local, .env.backend, .env.production.
#   - Rotate IBHA_JWT_SECRET immediately if it is ever exposed.
