# Ibha KSP — Backend Environment Variables
# ==========================================
# Copy this file to .env.backend and fill in DB_PASSWORD.
# .env.backend is listed in .gitignore and must NEVER be committed.
#
# Usage:
#   cp .env.backend.example .env.backend    (Linux/Mac)
#   copy .env.backend.example .env.backend  (Windows)
#   # then open .env.backend and set DB_PASSWORD
#   python local_server.py

# ── Database (Neon PostgreSQL — cloud) ───────────────────────────────────
# These values match the Neon project created for Ibha KSP.
# DB_PASSWORD must be pasted from the Neon Console → Connection Details.

DB_HOST=ep-square-queen-azfj7ad6.c-3.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner

# REQUIRED — paste your Neon password here.
# Find it at: Neon Console → Your Project → Connection Details → Password
# Never commit this file after adding the real password.
DB_PASSWORD=npg_l0OCVybYcm9K

# Neon requires SSL. Do not change this value.
DB_SSLMODE=require

# ── Database mode ─────────────────────────────────────────────────────────
# false = PostgreSQL (always primary for this project)
USE_CATALYST_DS=false

# ── Authentication ────────────────────────────────────────────────────────
# JWT signing secret — at least 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
IBHA_JWT_SECRET=change_me_generate_a_32_char_random_string

# ══════════════════════════════════════════════════════════════════════════
# Quick reference — exact commands after filling in DB_PASSWORD
# ══════════════════════════════════════════════════════════════════════════
#
#   Test connection:
#     python scripts/test_db_connection.py
#
#   Initialize schema + seed data:
#     python scripts/setup_cloud_postgres.py
#
#   Start backend:
#     python local_server.py
#
#   Start frontend (separate terminal):
#     cd web && npm run dev
#
# Security:
#   .gitignore excludes .env.backend — the password is never committed.
#   Rotate IBHA_JWT_SECRET if it is ever exposed.
